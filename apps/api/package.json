{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --env-file=../../.env.test",
    "test:coverage": "bun test --env-file=../../.env.test --coverage; bun scripts/coverage-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "@graphql-tools/schema": "^11.0.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@repo/auth": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/mailer": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.3.5",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.3.0",
    "@linear/sdk": "103.0.0",
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "eslint": "^9.39.0",
    "typescript": "^5.7.3"
  }
}
