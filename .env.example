# Shared .env for local dev and the self-hosting stack. Copy: cp .env.example .env
# Dev works with the values below as-is, except the secrets marked "generate one".
# Self-hosting needs real values for the secrets and public URLs; DATABASE_URL and
# S3_ENDPOINT are set by the compose file. Coolify uses docker-compose.coolify.yml.

# ── Postgres (docker-compose brings up the DB) ──
POSTGRES_USER=itsaplan
POSTGRES_PASSWORD=itsaplan
POSTGRES_DB=itsaplan
# Host port for the local dev DB. Change if 5432 is taken.
POSTGRES_PORT=5432

# ── Database connection (api + drizzle) ──
# Local; inside compose api reaches postgres by service name (postgres:5432).
DATABASE_URL=postgres://itsaplan:itsaplan@localhost:5432/itsaplan

# ── Public origins (each set once; every service derives from these) ──
# API_URL — api origin: auth handler, email links, and the web browser bundle.
# APP_URL — web origin: CORS/auth trusted origins, passkey, email links.
API_URL=http://localhost:3000
APP_URL=http://localhost:3001

# TRUST_PROXY — true when the api runs behind a reverse proxy that sets
# X-Forwarded-For / X-Real-IP; the portal's per-client sign-in limits, better-auth's rate
# limits and the audit log's IP addresses then use them. The proxy must overwrite
# X-Forwarded-For with the client's address: the first address in the header is taken,
# so a proxy that appends to a client's own header lets the client choose it.
# Leave false when clients reach the api directly (any client can send those headers).
TRUST_PROXY=false
# AUDIT_COUNTRY_HEADER — the header a trusted proxy sets with the client's country
# (ISO 3166-1 alpha-2), read for the audit log only when TRUST_PROXY=true.
# Cloudflare's CF-IPCountry by default.
AUDIT_COUNTRY_HEADER=CF-IPCountry

# ── Legal document URLs (web build args) ──
# Shown on the logged-out screens; Google OAuth sign-in requires the privacy policy
# to be reachable. Point them at this instance's own documents. Leave empty to hide
# the legal notice. Inlined into the web bundle at build time (rebuild web to change).
# PRIVACY_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms

# ── better-auth ──
BETTER_AUTH_SECRET=change-me-please-generate-a-real-secret  # openssl rand -base64 32
# Passkey (WebAuthn) relying party. Defaults to the APP_URL hostname.
# In prod set to the public frontend hostname (no scheme, no port).
# PASSKEY_RP_ID=app.example.com
# PASSKEY_RP_NAME=Its a Plan
# Cookie domain override. Defaults to the parent domain of APP_URL;
# set only for multi-label TLDs or deep subdomains.
# COOKIE_DOMAIN=.example.com

# ── API (Elysia) ──
API_PORT=3000

# ── S3 object store: RustFS (issue attachments; metadata stays in the DB) ──
# Leave S3_* unset to disable uploads. The keys double as RustFS root credentials;
# the secret must be >= 8 chars. Upload size limits are the MAX_*_MB / TEAM_QUOTA_MB
# variables; accepted file types are a workspace setting.
S3_ENDPOINT=http://localhost:9000      # inside compose: http://minio:9000
S3_BUCKET=planner-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1                    # required by the SDK, ignored by RustFS

# ── Internal token shared by api and worker ──
# Same value for both. openssl rand -base64 32
WORKER_INTERNAL_TOKEN=change-me-please-generate-a-real-secret

# ── Background worker (apps/worker): webhooks, notifications, cycle upkeep ──
# WEBHOOK_POLL_INTERVAL_MS=2000     # how often to poll for due deliveries
# WEBHOOK_BATCH_SIZE=20             # deliveries claimed/sent per tick
# WEBHOOK_TIMEOUT_MS=5000           # per-delivery HTTP timeout (Linear: 5 s)
# WEBHOOK_DISABLE_THRESHOLD=20      # consecutive failures before a webhook is auto-disabled
# WEBHOOK_LEASE_SECONDS=120         # claim lease; a crashed delivery is retried after this
# WEBHOOK_CLEANUP_DAYS=30           # succeeded deliveries older than this are deleted
# WEBHOOK_CLEANUP_EVERY_TICKS=300   # run the cleanup once every N ticks
# CYCLE_UPKEEP_EVERY_TICKS=1800    # cycle upkeep (close, rollover, upcoming, history) every N ticks
# NOTIFICATION_BATCH_SIZE=20        # notification deliveries claimed per tick
# NOTIFICATION_TIMEOUT_MS=20000     # internal send-API request timeout
# NOTIFICATION_MAX_ATTEMPTS=5       # attempts before a delivery is marked failed
# NOTIFICATION_LEASE_SECONDS=120    # claim lease for crash recovery

# ── Email ──
# Outbound email (magic links, invites, notifications). SMTP wins when both SMTP and
# Resend are set. With neither, magic links are written to the API log instead of
# sent, so an operator can still sign in, and nothing else is emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer
# SMTP_PASSWORD=
# SMTP_SECURE=starttls              # tls (implicit, port 465) | starttls | none
# RESEND_API_KEY=
# From address. Required for Resend (verified sender); for SMTP defaults to the SMTP
# username. NOTIFICATIONS_EMAIL_FROM is read as a fallback.
# EMAIL_FROM=Its a Plan <notifications@example.com>

# ── Joining the workspace ──
# People join by invite, or with an email address on one of these domains (comma-
# separated). The first account of a fresh instance always becomes the owner.
# APPROVED_EMAIL_DOMAINS=example.com

# ── Google sign-in ──
# OAuth client from the Google Cloud console; register <API_URL>/api/auth/callback/google
# as an authorized redirect URI. Unset means Google sign-in is unavailable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── GitHub issue import ──
# This instance's GitHub Import App (Settings → Workspace → Import → GitHub), set up as
# in docs/github-import-setup.md. Unset means GitHub imports are unavailable; GitLab,
# Gitea and Forgejo imports need nothing here. The private key goes on one line with
# its newlines written as \n.
# GITHUB_IMPORT_APP_ID=
# GITHUB_IMPORT_APP_SLUG=
# GITHUB_IMPORT_CLIENT_ID=
# GITHUB_IMPORT_CLIENT_SECRET=
# GITHUB_IMPORT_PRIVATE_KEY=
# For GitHub's API and web addresses other than github.com (tests use a stub server).
# GITHUB_IMPORT_API_URL=https://api.github.com
# GITHUB_IMPORT_WEB_URL=https://github.com

# ── Upload limits ──
# MAX_ATTACHMENT_MB=25    # largest single attachment
# MAX_AVATAR_MB=5         # largest avatar image
# TEAM_QUOTA_MB=51200     # stored attachment bytes per team; 0 = unlimited

# ── Web (Next.js) ──
# The browser bundle needs NEXT_PUBLIC_API_URL (= API_URL above) and the optional
# NEXT_PUBLIC_PRIVACY_URL / NEXT_PUBLIC_TERMS_URL (= PRIVACY_URL / TERMS_URL above),
# set in the separate apps/web/.env locally, or as Docker build args.
# WEB_PORT=3001   # host port for the web app; change if 3001 is taken
